# Copier en .env pour le développement local. Ne jamais versionner le vrai fichier.
JWT_SECRET=remplacez-par-une-longue-valeur-aleatoire
COOKIE_SECURE=false
# Adresse que le téléphone peut joindre : l'adresse de votre machine ou un tunnel, pas localhost.
PUBLIC_BASE_URL=http://192.168.1.20:8000
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
ALLOWED_EMAIL_DOMAINS=
